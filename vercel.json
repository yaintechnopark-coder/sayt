{
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{css/**,js/**,images/**,data/**,*.html,favicon.ico}"
    },
    "api/index.js": {
      "includeFiles": "{css/**,js/**,images/**,data/**,*.html,favicon.ico}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/home", "destination": "/index.html" },
    { "source": "/prepare-siele", "destination": "/prepare-siele.html" },
    { "source": "/comprobar-certificado", "destination": "/comprobar-certificado.html" },
    { "source": "/check-certificate", "destination": "/comprobar-certificado.html" },
    { "source": "/examenes", "destination": "/examenes.html" },
    { "source": "/modalidades", "destination": "/examenes.html" },
    { "source": "/conoce-siele", "destination": "/conoce-siele.html" },
    { "source": "/encuentra-centro", "destination": "/encuentra-centro.html" },
    { "source": "/encuentre-el-centro", "destination": "/encuentra-centro.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/portallogin", "destination": "/login.html" },
    { "source": "/es/portallogin", "destination": "/login.html" },
    { "source": "/pt/portallogin", "destination": "/login.html" },
    { "source": "/en/portallogin", "destination": "/login.html" },
    { "source": "/fr/portallogin", "destination": "/login.html" },
    { "source": "/mi-pagina", "destination": "/mi-pagina.html" },
    { "source": "/web/guest/mi-pagina", "destination": "/mi-pagina.html" },
    { "source": "/es/mi-pagina", "destination": "/mi-pagina.html" },
    { "source": "/pt/mi-pagina", "destination": "/mi-pagina.html" },
    { "source": "/en/mi-pagina", "destination": "/mi-pagina.html" },
    { "source": "/fr/mi-pagina", "destination": "/mi-pagina.html" },
    { "source": "/ayuda", "destination": "/ayuda.html" },
    { "source": "/faq", "destination": "/ayuda.html" }
  ]
}
